<Window x:Class="RigKit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RigKit · 矿卡工具箱"
        Width="1360"
        Height="860"
        MinWidth="1180"
        MinHeight="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{StaticResource CanvasBrush}"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="7"
                        Background="#17191F" Margin="12,0,0,0">
                    <TextBlock Text="MK" Foreground="White" FontSize="8" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="9,0,0,0">
                    <TextBlock Text="RigKit" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" />
                    <TextBlock Text="矿卡工具箱" FontSize="10" Foreground="{StaticResource FaintBrush}"
                               Margin="7,2,0,0" />
                </StackPanel>

                <Border Grid.Column="2" Background="{StaticResource SubtleBrush}" CornerRadius="6"
                        Padding="8,3" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DeviceName}" FontSize="10.5"
                                   Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text=" ▾" FontSize="9" Foreground="{StaticResource FaintBrush}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock Text="{Binding DriverVersion, StringFormat=驱动 {0}}" FontSize="9.5"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding PcieText, StringFormat=PCIe {0}}" FontSize="9.5"
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding TemperatureValue, StringFormat={}{0} ℃}" FontSize="9.5"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE921;"
                            Click="Minimize_Click" ToolTip="最小化" />
                    <Button Style="{StaticResource WindowButtonStyle}" Content="&#xE922;"
                            Click="Maximize_Click" ToolTip="最大化" />
                    <Button Style="{StaticResource CloseButtonStyle}" Content="&#xE8BB;"
                            Click="Close_Click" ToolTip="关闭" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FAFBFC"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="12,16,12,4">
                        <TextBlock Text="工作空间" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{StaticResource FaintBrush}" Margin="9,0,0,4" />
                        <RadioButton IsChecked="True" Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="工作台" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton IsEnabled="False" Style="{StaticResource NavItemStyle}"
                                     ToolTip="M1 开放">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE772;" FontFamily="{StaticResource IconFont}"
                                           FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="设备详情" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Margin="12,0,12,14" Padding="10"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="M0 · 只读模式" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" />
                            <TextBlock Text="写操作将在 M1 开放" FontSize="9.5"
                                       Foreground="{StaticResource FaintBrush}" Margin="0,2,0,0" />
                            <TextBlock Text="Apache-2.0" FontSize="9" Foreground="{StaticResource FaintBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,0,12,8">
                        <StackPanel>
                            <TextBlock Text="改造" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource FaintBrush}" Margin="9,12,0,4" />
                            <RadioButton IsEnabled="False" Style="{StaticResource NavItemStyle}"
                                         ToolTip="M2 开放">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFont}"
                                               FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="安全解锁" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton IsEnabled="False" Style="{StaticResource NavItemStyle}"
                                         ToolTip="M2 开放">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}"
                                               FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="型号伪装" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton IsEnabled="False" Style="{StaticResource NavItemStyle}"
                                         ToolTip="M3 开放">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource IconFont}"
                                               FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="双卡调度" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="调优" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource FaintBrush}" Margin="9,12,0,4" />
                            <RadioButton IsEnabled="False" Style="{StaticResource NavItemStyle}"
                                         ToolTip="M3 开放">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9E9;" FontFamily="{StaticResource IconFont}"
                                               FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="性能调优" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton IsEnabled="False" Style="{StaticResource NavItemStyle}"
                                         ToolTip="M3 开放">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}"
                                               FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="生态补丁" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton IsEnabled="False" Style="{StaticResource NavItemStyle}"
                                         ToolTip="M3 开放">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource IconFont}"
                                               FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="基准测试" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="维护" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{StaticResource FaintBrush}" Margin="9,12,0,4" />
                            <RadioButton IsEnabled="False" Style="{StaticResource NavItemStyle}"
                                         ToolTip="M1 开放">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}"
                                               FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="备份与恢复" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton IsEnabled="False" Style="{StaticResource NavItemStyle}"
                                         ToolTip="M1 开放">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}"
                                               FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="日志与诊断" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton IsEnabled="False" Style="{StaticResource NavItemStyle}"
                                         ToolTip="M4 开放">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}"
                                               FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="设置" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,18,24,22" MaxWidth="1120" HorizontalAlignment="Left">

                    <Grid Margin="0,0,0,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="工作台" Style="{StaticResource PageTitleStyle}" />
                                <Border Background="{StaticResource BrandWashBrush}" CornerRadius="999"
                                        Padding="8,2" Margin="10,3,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="只读模式" FontSize="9.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrandBrush}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <TextBlock Text="{Binding DeviceName, StringFormat=当前设备：{0}}"
                                           Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text=" · " Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="{Binding LastUpdatedText, StringFormat=最近更新 {0}}"
                                           Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text=" · 数据 1s 刷新" Style="{StaticResource MutedTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Content="刷新数据" Click="Refresh_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" />
                    </Grid>

                    <Border Background="{StaticResource DangerWashBrush}" BorderBrush="#F3B7B1"
                            BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,12"
                            Visibility="{Binding ErrorVisibility}">
                        <TextBlock Text="{Binding ErrorText}" Foreground="{StaticResource DangerBrush}"
                                   FontSize="11.5" TextWrapping="Wrap" />
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="当前设备 · GPU 0" FontSize="10"
                                           Foreground="{StaticResource FaintBrush}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding DeviceName}" FontSize="24"
                                               FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                    <Border Background="{StaticResource SubtleBrush}" CornerRadius="5"
                                            Padding="7,2" Margin="10,6,0,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding SupportLabel}" FontSize="9.5"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding DeviceMeta}" FontSize="11.5"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Border Background="{Binding StatusBackground}" CornerRadius="999"
                                            Padding="9,4">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="{Binding StatusBrush}"
                                                     Margin="0,0,5,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding StatusBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource SubtleBrush}" CornerRadius="999"
                                            Padding="9,4" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding DriverVersion, StringFormat=驱动 {0}}"
                                                   FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                    </Border>
                                    <Border Background="{StaticResource SubtleBrush}" CornerRadius="999"
                                            Padding="9,4" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding PcieText, StringFormat=PCIe {0}}"
                                                   FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Grid Width="116" Height="116">
                                    <Ellipse Stroke="#EEF0F3" StrokeThickness="8" />
                                    <Ellipse Stroke="{Binding ScoreBrush}" StrokeThickness="8"
                                             StrokeDashArray="{Binding ScoreDashArray}"
                                             StrokeDashCap="Round"
                                             StrokeStartLineCap="Round"
                                             StrokeEndLineCap="Round"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform Angle="-90" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HealthScore}"
                                                   FontFamily="{StaticResource NumberFont}"
                                                   FontSize="30" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="/ 100" FontSize="9"
                                                   Foreground="{StaticResource FaintBrush}"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding HealthLabel}" FontSize="12"
                                           FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Foreground="{Binding ScoreBrush}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding HealthSummary}" FontSize="9.5"
                                           Foreground="{StaticResource FaintBrush}"
                                           TextAlignment="Center" TextWrapping="Wrap"
                                           MaxWidth="200" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorder}"
                                Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="核心温度" Style="{StaticResource KpiLabelStyle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding TemperatureValue}"
                                               Style="{StaticResource KpiValueStyle}" />
                                    <TextBlock Text="℃" Style="{StaticResource KpiUnitStyle}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorder}"
                                Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="实时功耗" Style="{StaticResource KpiLabelStyle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding PowerValue}"
                                               Style="{StaticResource KpiValueStyle}" />
                                    <TextBlock Text="W" Style="{StaticResource KpiUnitStyle}" />
                                    <TextBlock Text="{Binding PowerLimitText}" FontSize="9"
                                               Foreground="{StaticResource FaintBrush}"
                                               VerticalAlignment="Bottom" Margin="2,0,0,5" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardBorder}"
                                Padding="14" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="显存占用" Style="{StaticResource KpiLabelStyle}" />
                                <TextBlock Text="{Binding MemoryValue}" FontFamily="{StaticResource NumberFont}"
                                           FontSize="20" FontWeight="SemiBold" Margin="0,6,0,0"
                                           Foreground="{StaticResource InkBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource CardBorder}" Padding="14">
                            <StackPanel>
                                <TextBlock Text="风扇转速" Style="{StaticResource KpiLabelStyle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding FanValue}"
                                               Style="{StaticResource KpiValueStyle}" />
                                    <TextBlock Text="%" Style="{StaticResource KpiUnitStyle}" />
                                </StackPanel>
                                <TextBlock Text="{Binding UtilizationValue, StringFormat=负载 {0}%}"
                                           FontSize="9" Foreground="{StaticResource FaintBrush}"
                                           Margin="0,1,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardBorder}"
                                Margin="0,0,10,0" Padding="16">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="待处理" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock Text="{Binding RiskCount, StringFormat={}{0} 项}"
                                               FontSize="10" Foreground="{StaticResource FaintBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Risks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Background}" CornerRadius="8"
                                                    Padding="10,8" Margin="0,6,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="3" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Background="{Binding Accent}" CornerRadius="2" />
                                                    <StackPanel Grid.Column="1" Margin="9,0,0,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource InkBrush}" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="10"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Padding="16">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="实时曲线" Style="{StaticResource SectionTitleStyle}" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource BrandLightBrush}"
                                                 Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="温度" FontSize="9"
                                                   Foreground="{StaticResource FaintBrush}" Margin="0,0,10,0" />
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource FaintBrush}"
                                                 Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="功耗" FontSize="9"
                                                   Foreground="{StaticResource FaintBrush}" />
                                    </StackPanel>
                                </Grid>
                                <Viewbox Stretch="Fill" Height="96" Margin="0,10,0,0">
                                    <Grid Width="300" Height="84">
                                        <Polyline Points="{Binding TemperaturePoints}"
                                                  Stroke="{StaticResource BrandLightBrush}"
                                                  StrokeThickness="2" StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        <Polyline Points="{Binding PowerPoints}"
                                                  Stroke="{StaticResource FaintBrush}"
                                                  StrokeThickness="1.4" StrokeDashArray="3 3"
                                                  StrokeLineJoin="Round" />
                                    </Grid>
                                </Viewbox>
                                <TextBlock Text="最近 60 秒 · 温度 / 功耗" FontSize="9"
                                           Foreground="{StaticResource FaintBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="刷新数据" Click="Refresh_Click"
                                Style="{StaticResource PrimaryButtonStyle}" />
                        <Button Content="创建快照 · M1" IsEnabled="False"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" />
                        <Button Content="游戏 Profile · M3" IsEnabled="False"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" />
                        <Button Content="导出报告 · M1" IsEnabled="False"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" />
                    </StackPanel>

                    <TextBlock Text="M0 只读：当前只开放设备识别与传感器读取，任何写操作都不会执行。"
                               FontSize="10" Foreground="{StaticResource FaintBrush}" Margin="0,10,0,0" />
                </StackPanel>
            </ScrollViewer>

                <Border Background="{StaticResource CanvasBrush}" Visibility="{Binding LoadingVisibility}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="正在读取设备…" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="NVML → nvidia-smi" FontSize="11"
                                   Foreground="{StaticResource FaintBrush}" Margin="0,6,0,0"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CanvasBrush}" Visibility="{Binding EmptyVisibility}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                        <TextBlock Text="未发现 NVIDIA 设备" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="检查驱动是否安装，或点击重新扫描。" FontSize="11.5"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                        <Button Content="重新扫描" Click="Rescan_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                HorizontalAlignment="Center" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" Fill="{StaticResource SuccessBrush}"
                             Margin="0,0,6,0" />
                    <TextBlock Text="{Binding ProviderText}" FontSize="9.5"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <TextBlock Text="只读模式 · 写操作未开放" FontSize="9.5"
                           Foreground="{StaticResource FaintBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LastUpdatedText, StringFormat=最近更新 {0}}"
                               FontSize="9.5" Foreground="{StaticResource FaintBrush}" />
                    <TextBlock Text="{Binding VersionText}" FontSize="9.5"
                               Foreground="{StaticResource FaintBrush}" Margin="12,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
