<Page x:Class="RigKit.Desktop.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">
        <StackPanel Padding="28,24,28,28" Spacing="16" Width="900" HorizontalAlignment="Center">
            <StackPanel Spacing="4">
                <TextBlock Text="设置" FontSize="32" FontWeight="SemiBold" />
                <TextBlock Text="外观、侧栏与版本信息"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="24">
                <StackPanel Spacing="16">
                    <TextBlock Text="外观" FontSize="16" FontWeight="SemiBold" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="深色模式" FontSize="13" />
                            <TextBlock Text="在浅色与深色之间切换，立即生效。"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="DarkModeToggle" Grid.Column="1"
                                      OnContent="" OffContent=""
                                      Toggled="DarkModeToggle_Toggled"
                                      VerticalAlignment="Center" />
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="折叠侧栏" FontSize="13" />
                            <TextBlock Text="收起后只保留图标，给内容更多空间。"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SidebarToggle" Grid.Column="1"
                                      OnContent="" OffContent=""
                                      Toggled="SidebarToggle_Toggled"
                                      VerticalAlignment="Center" />
                    </Grid>

                    <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="窗口边框" FontSize="13" />
                            <TextBlock Text="始终显示 1 px 深色描边，方便和其他窗口分层。"
                                       FontSize="11"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="固定" Grid.Column="1" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="24">
                <StackPanel Spacing="10">
                    <TextBlock Text="关于" FontSize="16" FontWeight="SemiBold" />
                    <Grid>
                        <TextBlock Text="版本" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="VersionText" FontSize="12" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="开源协议" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Apache-2.0" FontSize="12" HorizontalAlignment="Right" />
                    </Grid>
                    <Grid>
                        <TextBlock Text="仓库" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="github.com/1922708082/rigkit" FontSize="12"
                                   Foreground="{ThemeResource AppBrandBrush}" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="设置会自动保存到 %LOCALAPPDATA%\RigKit\app.json"
                       FontSize="11"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
