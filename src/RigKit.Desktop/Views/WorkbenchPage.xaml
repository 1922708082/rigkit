<Page x:Class="RigKit.Desktop.Views.WorkbenchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">
        <StackPanel Padding="28,24,28,28" Spacing="16" HorizontalAlignment="Stretch">
            <StackPanel Spacing="4">
                <TextBlock Text="工作台" FontSize="32" FontWeight="SemiBold" />
                <TextBlock x:Name="SubtitleText"
                           Text="WinUI 3 壳已接入，正在读取设备…"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="24">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="7" Height="7" Fill="{ThemeResource SystemFillColorSuccessBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="正在读取设备…" FontSize="12"
                                       Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="· 只读模式" FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <TextBlock x:Name="DeviceNameText" Text="NVIDIA CMP 90HX"
                                   FontSize="30" FontWeight="SemiBold" />

                        <TextBlock x:Name="DeviceMetaText" Text="GA102 · 10 GB · 驱动 616.92"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Border Background="{ThemeResource AppBrandWashBrush}" CornerRadius="4" Padding="8,3">
                                <TextBlock Text="WinUI 3" FontSize="11"
                                           Foreground="{ThemeResource AppBrandBrush}" />
                            </Border>
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="4" Padding="8,3">
                                <TextBlock Text="Mica" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    CornerRadius="4" Padding="8,3">
                                <TextBlock Text="PCIe Gen2 x16" FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="健康分" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="--" FontSize="46" FontWeight="SemiBold"
                                   FontFamily="Bahnschrift" HorizontalAlignment="Right" />
                        <TextBlock Text="体检服务待接入" FontSize="10"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="核心温度" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="TemperatureText" Text="--" FontSize="30"
                                       FontFamily="Bahnschrift" FontWeight="SemiBold" />
                            <TextBlock Text="℃" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="实时功耗" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="PowerText" Text="--" FontSize="30"
                                       FontFamily="Bahnschrift" FontWeight="SemiBold" />
                            <TextBlock Text="W" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="显存占用" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="VramText" Text="--" FontSize="30"
                                       FontFamily="Bahnschrift" FontWeight="SemiBold" />
                            <TextBlock Text="MB" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="风扇转速" FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock x:Name="FanText" Text="--" FontSize="30"
                                       FontFamily="Bahnschrift" FontWeight="SemiBold" />
                            <TextBlock Text="%" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="P0 · WinUI 3 壳已接入" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="Mica 背景、NavigationView 侧栏、原生标题栏已启用；设备数据来自现有 NVML 服务，下一步接入体检与曲线。"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="窗口边框、深浅主题和侧栏收缩将在 P1 完成。"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
