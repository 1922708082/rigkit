<Window x:Class="RigKit.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RigKit">
    <Border x:Name="WindowFrame"
            BorderBrush="{ThemeResource WindowBorderBrush}"
            BorderThickness="1"
            Background="{ThemeResource AppCanvasBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,140,0">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="24" Height="24" CornerRadius="7" Background="{ThemeResource AppBrandBrush}">
                        <TextBlock Text="RK" FontSize="8" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="RigKit" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="矿卡工具箱" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="WinUI 3 · M1 只读"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <NavigationView x:Name="NavView"
                            Grid.Row="1"
                            PaneDisplayMode="Left"
                            OpenPaneLength="224"
                            CompactPaneLength="48"
                            IsPaneToggleButtonVisible="True"
                            IsSettingsVisible="False"
                            IsBackButtonVisible="Collapsed"
                            Background="Transparent"
                            SelectionChanged="NavView_SelectionChanged"
                            PaneOpening="NavView_PaneOpening"
                            PaneClosing="NavView_PaneClosing">
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="WorkbenchItem" Content="工作台" Tag="workbench">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE80F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="设备详情" Tag="device" IsEnabled="False">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE772;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItemSeparator />
                    <NavigationViewItem Content="安全解锁" Tag="unlock" IsEnabled="False">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE90F;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="型号伪装" Tag="spoof" IsEnabled="False">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8B9;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="性能调优" Tag="tuning" IsEnabled="False">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE9E9;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="备份与恢复" Tag="backup" IsEnabled="False">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE74E;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItemSeparator />
                    <NavigationViewItem x:Name="SettingsItem" Content="设置" Tag="settings">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE713;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <NavigationView.FooterMenuItems>
                    <NavigationViewItem Content="只读模式" SelectsOnInvoked="False" IsEnabled="False">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE72E;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.FooterMenuItems>

                <Frame x:Name="ContentFrame" IsNavigationStackEnabled="False" />
            </NavigationView>
        </Grid>
    </Border>
</Window>
